# Leave these empty to run against the local emulators (npm run dev:emulators).
# To use a real Firebase project, copy this file to .env.local and fill it in
# from Project settings > Your apps in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
